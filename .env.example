# ============================================
# 闲鱼智控 PRO - 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改
# ============================================

# ---- 基础配置 ----
# 外部访问端口（映射到容器8080端口）
WEB_PORT=18080

# 时区设置
TZ=Asia/Shanghai

# 调试模式（生产环境请设为 false）
DEBUG=false
RELOAD=false

# ---- 安全配置 ----
# 管理员用户名和密码（首次初始化使用，修改后请删除或重置）
ADMIN_USERNAME=admin
# 【重要】请务必修改默认密码为强密码
ADMIN_PASSWORD=change_this_to_a_strong_password

# JWT密钥（用于签名会话令牌，请使用随机字符串）
# 生成方式: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=please_replace_with_random_secret_key

# 会话超时时间（秒），默认1小时
SESSION_TIMEOUT=3600

# ---- CORS跨域配置 ----
# 允许的源地址，多个用逗号分隔
# 设为 * 表示允许所有源（不支持携带Cookie凭证）
# 设为具体地址如 http://localhost:5173,https://your-domain.com 则支持Cookie凭证
CORS_ORIGINS=*

# ---- 数据库配置 ----
DB_PATH=/app/data/xianyu_data.db

# ---- 日志配置 ----
LOG_LEVEL=INFO
# SQL日志脱敏处理（已自动对密码等敏感字段脱敏）
SQL_LOG_ENABLED=true
SQL_LOG_LEVEL=INFO

# ---- 多用户配置 ----
MULTIUSER_ENABLED=true
USER_REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=true
CAPTCHA_ENABLED=true
TOKEN_EXPIRE_TIME=86400

# ---- 自动发货配置 ----
AUTO_REPLY_ENABLED=true
AUTO_DELIVERY_ENABLED=true
AUTO_DELIVERY_TIMEOUT=30
API_CARD_TIMEOUT=10
BATCH_DATA_LOCK_TIMEOUT=5

# ---- AI配置 ----
AI_REPLY_ENABLED=false
DEFAULT_AI_MODEL=qwen-plus
DEFAULT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_REQUEST_TIMEOUT=30
AI_MAX_TOKENS=100

# ---- WebSocket配置 ----
WEBSOCKET_URL=wss://wss-goofish.dingtalk.com/
HEARTBEAT_INTERVAL=15
HEARTBEAT_TIMEOUT=5
TOKEN_REFRESH_INTERVAL=3600
TOKEN_RETRY_INTERVAL=300
MESSAGE_EXPIRE_TIME=300000

# ---- Webhook 外部推送配置 ----
# 注意：以下配置项可在后台「系统设置」页面中可视化配置，此处仅作参考
# WEBHOOK_ENABLED=true          # 启用 Webhook 推送（true/false）
# WEBHOOK_URL=https://your-n8n.example.com/webhook/xxx
# WEBHOOK_SECRET=                # 签名密钥（可选，留空则不签名）
# WEBHOOK_EVENTS=new_order,order_updated,message_received,delivery_completed
# 推送的事件类型（逗号分隔），不设置则推送全部事件

# ---- 资源限制 ----
MEMORY_LIMIT=2048
CPU_LIMIT=2.0
MEMORY_RESERVATION=512
CPU_RESERVATION=0.5
