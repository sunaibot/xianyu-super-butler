# ============================================
# 闲鱼自动回复系统 - 环境配置模板
# 复制此文件为 .env 并修改配置
# ============================================
# 说明：本系统使用 Session 认证（非 JWT），功能开关与 AI 配置在 global_config.yml 中设置。
#       此处仅保留容器启动与代码实际读取的变量。

# ===== 必须修改的安全配置 =====
# 管理员初始用户名
ADMIN_USERNAME=admin

# 管理员初始密码（至少8位，包含字母和数字；未设置则容器启动失败）
ADMIN_PASSWORD=changeme_123

# 管理员初始邮箱
ADMIN_EMAIL=admin@example.com

# ===== 基本配置 =====
# 时区
TZ=Asia/Shanghai

# Web 端口（宿主机映射）
WEB_PORT=18080

# ===== 数据库 =====
# SQLite 数据库路径（容器内部）
DB_PATH=/app/data/xianyu_data.db

# ===== 跨域与日志（代码实际读取）=====
# 允许的跨域来源，多个用逗号分隔；* 表示允许全部（生产环境建议指定域名）
CORS_ORIGINS=*

# 是否记录 SQL 日志（true/false）
SQL_LOG_ENABLED=false
# SQL 日志级别: DEBUG, INFO, WARNING
SQL_LOG_LEVEL=INFO

# ===== 资源限制（Docker 层，容器级别）=====
# 内存限制 (MB)
MEMORY_LIMIT=2048
# CPU 限制 (核数)
CPU_LIMIT=2.0
# 内存预留 (MB)
MEMORY_RESERVATION=512
# CPU 预留 (核数)
CPU_RESERVATION=0.5
